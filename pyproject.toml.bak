[project]
name = "crysfipy"
version = "1.2.0"
description = "Tools for analysis of physical properties arising from crystal-field Hamiltonian."
readme = "README.md"
authors = [
        {name = 'Michal Stekiel', email = 'michal.stekiel@frm2.tum.de'},
        {name = 'Petr Čermák'},
]
requires-python = ">=3.6,<3.11"
dependencies = [
    'numpy>=1.20.5',    # was 1.23.5 before
    'scipy>=1.5.1',     # was 1.9.1 before
    "sympy>=1.1.0",
]

[dependency-groups]
dev = [
    "furo>=2022.12.19",
    "pytest>=7.0.2",    # was 9.02 before 
    "sphinx>=4.1.3",    # was 8.1.3 before
]
